# Copy to .env.local and fill in. Never commit .env.local — .gitignore covers it.

# --- Supabase ---------------------------------------------------------------
# NEXT_PUBLIC_ here is correct and intentional: the anon key is meant to reach
# the browser and is guarded by row-level security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google OAuth client id, if using Google sign-in directly.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Base URL used to build QR codes and join links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- AI assistant -----------------------------------------------------------
# Server-only. These are billing credentials and must NOT be NEXT_PUBLIC_, which
# would inline them into the browser bundle. Read only in app/api/assistant.

# Required for the assistant. Without it the endpoint returns 503.
OPENROUTER_API_KEY=

# Optional. Without it the assistant simply isn't offered a web_search tool.
TAVILY_API_KEY=
